{
  "name": "lyor",
  "version": "1.2.0",
  "private": true,
  "description": "Lyor V1.2 Windows desktop baseline",
  "author": "Lyor",
  "license": "UNLICENSED",
  "main": "dist-electron/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "rimraf dist-electron",
    "dev": "concurrently -k -s first -n renderer,electron-compiler,desktop \"npm:dev:renderer\" \"npm:dev:electron:watch\" \"npm:dev:electron:run\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron:watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron:run": "wait-on tcp:127.0.0.1:5173 dist-electron/main/index.js dist-electron/preload/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "clean": "rimraf dist dist-electron",
    "build": "npm run clean && npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:supabase": "node scripts/test-supabase.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "verify:release": "node scripts/verify-release-artifacts.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.node.json",
    "start": "electron .",
    "build:prod": "npm run build",
    "dist:win": "npm run build:prod && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "package:win": "npm run dist:win",
    "publish:win": "npm run build:prod && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "supabase": "2.115.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
