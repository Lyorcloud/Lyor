# GitHub release target is verified in electron-builder.config.cjs as Lyorcloud/Lyor.

# Publish credential. Keep this blank here; set it only in the shell or CI secret store.
GH_TOKEN=

# Optional Windows Authenticode signing credentials for public distribution.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=

# Supabase Auth client configuration. The URL and publishable key are consumed
# by Electron main only. Publishable keys are designed for clients but must not
# be confused with service-role/secret keys. Never put privileged keys here.
LYOR_SUPABASE_URL=
LYOR_SUPABASE_PUBLISHABLE_KEY=

# The following names belong only in a Supabase Edge Function/backend secret
# store, never in the desktop environment or renderer bundle. They are listed
# here as deployment documentation and intentionally have no values.
SUPABASE_SERVICE_ROLE_KEY=
PLANARIA_STORAGE_SIGNER_URL=
PLANARIA_STORAGE_SIGNER_SECRET=
ANALYTICS_VERIFICATION_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
