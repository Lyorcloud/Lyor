{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyor.app/schemas/installation-manifest-v2.json",
  "title": "Lyor Advanced Installation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mod", "game", "adapter", "requiredCapabilities", "sources", "operations", "dependencies", "conflicts", "installedSize"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "mod": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,119}$" }, "version": { "type": "string", "minLength": 1, "maxLength": 80 } } },
    "game": { "type": "object", "additionalProperties": false, "required": ["id", "edition"], "properties": { "id": { "type": "string", "pattern": "^(gta5-(legacy|enhanced)|game-[a-z0-9-]+)$" }, "edition": { "enum": ["legacy", "enhanced", "standard"] }, "versionRange": { "type": "string", "minLength": 1, "maxLength": 80 } } },
    "adapter": { "type": "string", "minLength": 1, "maxLength": 120 },
    "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["file-operations", "archive-operations", "mod-layer", "config-merge", "version-detection", "validation"] } },
    "sources": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": { "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,120}$" }, "path": { "$ref": "#/$defs/relativePath" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
    "operations": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["type", "target"], "properties": { "type": { "enum": ["ARCHIVE_ADD", "ARCHIVE_REPLACE", "ARCHIVE_DELETE", "CONFIG_MERGE"] }, "target": { "$ref": "#/$defs/relativePath" }, "entry": { "$ref": "#/$defs/relativePath" }, "source": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,120}$" }, "format": { "const": "json" } } } },
    "dependencies": { "type": "array" },
    "conflicts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "installedSize": { "type": "integer", "minimum": 0 }
  },
  "$defs": { "relativePath": { "type": "string", "minLength": 1, "maxLength": 1024, "not": { "pattern": "(^[\\/])|(^[A-Za-z]:)|(^|[\\/])\\.\\.([\\/]|$)|\\u0000" } } }
}
