{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyor.app/schemas/installation-manifest-v1.json",
  "title": "Lyor Installation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mod", "game", "adapter", "sources", "operations", "dependencies", "conflicts", "checksums", "installedSize"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,119}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "edition"],
      "properties": {
        "id": { "type": "string", "pattern": "^(gta5-(legacy|enhanced)|game-[a-z0-9-]+)$" },
        "edition": { "enum": ["legacy", "enhanced", "standard"] },
        "versionRange": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "adapter": { "const": "generic-files" },
    "sources": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,120}$" },
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": { "enum": ["COPY_FILE", "COPY_FOLDER", "REPLACE_FILE", "DELETE_FILE", "CREATE_DIRECTORY"] },
          "source": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,120}$" },
          "target": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modId", "versionRange", "optional"],
        "properties": {
          "modId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,119}$" },
          "versionRange": { "type": "string", "minLength": 1, "maxLength": 80 },
          "optional": { "type": "boolean" }
        }
      }
    },
    "conflicts": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,119}$" }, "uniqueItems": true },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm"],
      "properties": { "algorithm": { "const": "sha256" } }
    },
    "installedSize": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "not": { "pattern": "(^[\\/])|(^[A-Za-z]:)|(^|[\\/])\\.\\.([\\/]|$)|\\u0000" }
    }
  }
}
